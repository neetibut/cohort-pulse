# MongoDB Atlas connection string (from pre-flight).
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/cohortpulse
MONGODB_URI=

# Redis URL.
# Local dev: leave blank — the Socket.IO Redis adapter is skipped.
# Production (Render Key Value): use the INTERNAL connection URL.
REDIS_URL=

# Comma-separated allowed origins for CORS + Socket.IO.
# http://localhost:5173 is always allowed even if this is blank.
# Production: your Vercel URL, e.g. https://cohort-pulse-xxxx.vercel.app
CLIENT_ORIGIN=

# Port. Leave UNSET in production (Render injects PORT). Defaults to 3001.
PORT=3001
